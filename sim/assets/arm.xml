<mujoco model="pancake_robot">

    <compiler angle="radian" autolimits="true"/>

    <option
        timestep="0.001"
        gravity="0 0 -9.81"
        integrator="RK4"/>

    <default>

        <joint
            damping="0.10"
            armature="0.01"/>

        <geom
            condim="3"
            friction="0.9 0.05 0.02"/>

        <motor
            ctrllimited="true"
            ctrlrange="-30 30"/>

    </default>

    <asset>

        <material
            name="robot_mat"
            rgba="0.25 0.25 0.28 1"/>

        <material
            name="pan_mat"
            rgba="0.10 0.10 0.12 1"/>

        <material
            name="pancake_mat"
            rgba="0.72 0.42 0.16 1"/>

        <material
            name="floor_mat"
            rgba="0.30 0.30 0.30 1"/>

    </asset>


    <worldbody>

        <geom
            name="floor"
            type="plane"
            size="5 5 0.1"
            material="floor_mat"/>


        <!-- ================================= -->
        <!-- ELBOW                            -->
        <!-- ================================= -->

        <body
            name="base"
            pos="0 0 0.30">

            <joint
                name="elbow"
                type="hinge"
                axis="0 1 0"
                range="-2.6 2.6"/>


            <!-- ELBOW → WRIST -->
            <geom
                name="upper_arm"
                type="capsule"
                fromto="0 0 0 0.40 0 0"
                size="0.055"
                mass="0.50"
                material="robot_mat"/>


            <!-- ================================= -->
            <!-- WRIST                             -->
            <!-- ================================= -->

            <body
                name="wrist_link"
                pos="0.40 0 0">

                <joint
                    name="wrist"
                    type="hinge"
                    axis="0 1 0"
                    range="-3.0 3.0"/>


                <!-- WRIST → PAN -->
                <geom
                    name="forearm"
                    type="capsule"
                    fromto="0 0 0 0.40 0 0"
                    size="0.045"
                    mass="0.35"
                    material="robot_mat"/>


                <!-- PAN -->
                <body
                    name="pan"
                    pos="0.40 0 0">

                    <geom
                        name="pan_bottom"
                        type="cylinder"
                        size="0.14 0.015"
                        mass="0.15"
                        material="pan_mat"/>

                    <geom
                        name="pan_front"
                        type="box"
                        size="0.14 0.012 0.025"
                        pos="0 0.115 0.025"
                        material="pan_mat"/>

                    <geom
                        name="pan_back"
                        type="box"
                        size="0.14 0.012 0.025"
                        pos="0 -0.115 0.025"
                        material="pan_mat"/>

                    <geom
                        name="pan_left"
                        type="box"
                        size="0.012 0.10 0.025"
                        pos="-0.115 0 0.025"
                        material="pan_mat"/>

                    <geom
                        name="pan_right"
                        type="box"
                        size="0.012 0.10 0.025"
                        pos="0.115 0 0.025"
                        material="pan_mat"/>

                </body>

            </body>

        </body>


        <!-- ================================= -->
        <!-- PANCAKE                           -->
        <!-- ================================= -->

        <body
            name="pancake"
            pos="0.80 0 0.35">

            <freejoint
                name="pancake_free"/>

            <geom
                name="pancake_geom"
                type="cylinder"
                size="0.095 0.012"
                mass="0.08"
                material="pancake_mat"
                friction="1.0 0.05 0.02"/>

        </body>

    </worldbody>


    <!-- ================================= -->
    <!-- MOTORS                            -->
    <!-- ================================= -->

    <actuator>

        <motor
            name="elbow_motor"
            joint="elbow"
            gear="8"/>

        <motor
            name="wrist_motor"
            joint="wrist"
            gear="8"/>

    </actuator>

</mujoco>